# Secrets for docker-compose. Copy to .env (not tracked in git) and set all values:
#   cp .env.example .env && chmod 600 .env
# Random values: openssl rand -hex 24
# DB_PASSWORD and RABBITMQ_USER/RABBITMQ_PASSWORD must match the URLs in
# docker/coriolis.conf ([database] connection, transport_url).

# MariaDB
DB_ROOT_PASSWORD=<CHANGE_ME>
DB_PASSWORD=<CHANGE_ME>

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<CHANGE_ME>
RABBITMQ_ERLANG_COOKIE=<CHANGE_ME>
